{
  "name": "encchat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser client for encchat: end-to-end encrypted 1:1 chat over a blind relay.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wasm-pack": "^0.13.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "wasm-pack@0.13.1": true
  }
}
